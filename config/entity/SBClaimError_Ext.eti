<?xml version="1.0"?>
<entity
  xmlns="http://guidewire.com/datamodel"
  entity="SBClaimError_Ext"
  type="retireable"
  desc="Error table for permanently failed SB integration records"
  platform="ClaimCenter">

  <column name="ExternalClaimID_Ext"  type="varchar"  size="100" desc="SB Portal Claim ID"/>
  <column name="NotificationType_Ext" type="varchar"  size="50"  desc="Notification type at time of failure"/>
  <column name="RawPayload_Ext"       type="clob"                desc="Raw JSON payload"/>
  <column name="ErrorMessage_Ext"     type="clob"                desc="Final error message"/>
  <column name="RetryCount_Ext"       type="integer"             desc="Total retries attempted"/>
  <column name="FailedDate_Ext"       type="datetime"            desc="Timestamp of permanent failure"/>
</entity>
