<?xml version="1.0"?>
<entity
  xmlns="http://guidewire.com/datamodel"
  entity="SBUnattachedDocument_Ext"
  table="SBUnattachedDocument_Ext"
  type="retireable"
  platform="false"
  desc="Temporary store for SB messages/documents not yet linked to a CC Claim">

  <column name="ExternalClaimID_Ext" type="varchar"  maxLength="100" nullok="true"  desc="SB Portal Claim ID"/>
  <column name="AttachmentID_Ext"    type="varchar"  maxLength="100" nullok="true"  desc="SB attachment ID"/>
  <column name="Description_Ext"     type="varchar"  maxLength="500" nullok="true"  desc="Document/message description"/>
  <column name="RawContent_Ext"      type="clob"                     nullok="true"  desc="Raw content"/>
  <column name="Author_Ext"          type="varchar"  maxLength="200" nullok="true"  desc="Author name"/>
  <column name="Converted_Ext"       type="bit"                      nullok="false" desc="True when converted to standard object"/>
</entity>
