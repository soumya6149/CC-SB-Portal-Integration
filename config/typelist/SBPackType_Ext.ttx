<?xml version="1.0"?>
<typelistextension
  xmlns="http://guidewire.com/typelists"
  name="SBPackType_Ext"
  desc="SB Portal pack type">
  <typecode code="Standard"    name="Standard"    desc="Standard SB pack"    priority="1"/>
  <typecode code="FastTrack"   name="Fast Track"  desc="Fast track pack"     priority="2"/>
  <typecode code="Complex"     name="Complex"     desc="Complex injury pack" priority="3"/>
  <typecode code="Psychiatric" name="Psychiatric" desc="Psychiatric pack"    priority="4"/>
  <typecode code="Fatal"       name="Fatal"       desc="Fatal injury pack"   priority="5"/>
</typelistextension>
