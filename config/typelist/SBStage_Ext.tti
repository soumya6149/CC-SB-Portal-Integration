<?xml version="1.0"?>
<typelist
  xmlns="http://guidewire.com/typelists"
  name="SBStage_Ext"
  desc="SB Portal processing stage"
  final="false">
  <typecode code="Undefined" name="Undefined" desc="Stage not yet determined" priority="1"/>
  <typecode code="New" name="New" desc="Newly received" priority="2"/>
  <typecode code="InProgress" name="In Progress" desc="Currently being processed" priority="3"/>
  <typecode code="Acknowledged" name="Acknowledged" desc="Acknowledged by adjuster" priority="4"/>
  <typecode code="Withdrawn" name="Withdrawn" desc="Withdrawn by claimant" priority="5"/>
  <typecode code="TimedOut" name="Timed Out" desc="Deadline exceeded" priority="6"/>
  <typecode code="Completed" name="Completed" desc="Successfully completed" priority="7"/>
</typelist>
